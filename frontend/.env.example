# DevConnect Frontend Environment Configuration

# Backend API endpoint (in development, leave empty to use Vite proxy or localhost:6969)
# In production, set to your deployed backend URL: https://api.yourdomain.com/api/v1
VITE_API_URL=

# Socket.io server endpoint (in development, leave empty to use localhost:6969)
# In production, set to your deployed backend domain: https://api.yourdomain.com
VITE_SOCKET_URL=

# Google OAuth Client ID (for Google Sign In)
VITE_GOOGLE_CLIENT_ID=776588942580-gq8b04cfuqjmcu19jj6rrgtfgrgg8prr.apps.googleusercontent.com

# GitHub OAuth Client ID
VITE_GITHUB_CLIENT_ID=

