# ==============================================================================
# DevConnect Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values appropriate for your environment.
# NEVER commit your actual .env file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port the Express/Socket.io server listens on
PORT=6969

# Environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed frontend client origin URLs for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Connection string to your MongoDB Atlas cluster or local MongoDB instance.
# Required. Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/devconnect?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Primary JWT secret for signing authentication access tokens. Required.
# Generate a cryptographically secure key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_random_hex_string

# Optional separate secret for signing refresh tokens (falls back to JWT_SECRET if unset)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_random_hex_string

# Access token lifespan (e.g. '15m', '1h')
JWT_ACCESS_EXPIRE=15m

# Refresh token lifespan (e.g. '7d', '30d')
JWT_EXPIRE=7d

# AES-256 secret key for encrypting chat messages in MongoDB.
# In production, this MUST be set to a secure, unique key.
MESSAGE_ENCRYPTION_KEY=your_secure_message_encryption_key_32bytes

# ------------------------------------------------------------------------------
# 4. CACHING & REALTIME PRESENCE (REDIS / UPSTASH)
# ------------------------------------------------------------------------------
# Redis connection URL (Upstash or Redis Cloud or local Redis).
# If unreachable or unset, the server automatically falls back to an in-memory client for local dev.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ------------------------------------------------------------------------------
# 5. OAUTH INTEGRATIONS
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# GitHub OAuth App Credentials (from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

# GitHub Personal Access Token (classic, read-only: public_repo, read:user)
# Used by cron job and profile sync to fetch user contribution calendars & streak stats without strict rate limits
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ------------------------------------------------------------------------------
# 6. AI FEATURES (GROQ / LLAMA)
# ------------------------------------------------------------------------------
# Groq Cloud API Key for AI features (idea generation, team fit analysis, role matching)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM model selection
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_MODEL_STRONG=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 7. MEDIA STORAGE (CLOUDINARY)
# ------------------------------------------------------------------------------
# Cloudinary account credentials for avatar and team cover uploads
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
